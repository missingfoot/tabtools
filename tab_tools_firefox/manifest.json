{
  "manifest_version": 3,
  "name": "Tab Tools",
  "version": "1.3.0",
  "description": "Powerful tab management tools: group, copy, organize, and manage your Firefox tabs efficiently with keyboard shortcuts and modern UI",
  "permissions": ["tabs", "tabGroups", "clipboardWrite", "downloads", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-tools@jamessparkes.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "images/chrome/icon16.png",
    "48": "images/chrome/icon48.png",
    "128": "images/chrome/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/dark/icon16.png",
      "48": "images/dark/icon48.png",
      "128": "images/dark/icon128.png"
    }
  }
}
